#!/usr/bin/env bash
# Enables the ai-sync timer. Re-runs only when this script changes.
{{- if eq .platform "darwin" }}
echo "deps: WARN no scheduler on macOS yet; run 'ai-sync pull' by hand (see README)"
{{- else }}
if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable --now ai-sync.timer || echo "deps: WARN could not enable ai-sync.timer"
else
  echo "deps: WARN systemctl --user unavailable; ai-sync timer not enabled (see README, Troubleshooting)"
fi
{{- end }}
