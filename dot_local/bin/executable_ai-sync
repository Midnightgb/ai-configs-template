#!/usr/bin/env bash
# ai-sync: keep AI-agent config in sync across machines through a chezmoi repo.
#   ai-sync capture [PATH...] copy this machine's config into the repo (first machine, or new files)
#   ai-sync pull              pull + apply, unless there is local drift (used by the timer)
#   ai-sync status            show local drift and the last pull result
#   ai-sync push [-m MSG]     capture local changes, scan for secrets, commit and push
#   ai-sync hook              Claude Code SessionStart hook: one-line warning when not in sync
set -u

STATE_DIR="$HOME/.local/state/ai-sync"
STATE="$STATE_DIR/status"
LOG="$STATE_DIR/last-pull.log"
mkdir -p "$STATE_DIR"

SRC=$(chezmoi source-path 2>/dev/null) || { echo "ai-sync: chezmoi source not found (run chezmoi init first)" >&2; exit 1; }
MACHINE=$(chezmoi execute-template '{{ .machine }}' 2>/dev/null || hostname)
# New local files under these dirs are reported as drift (chezmoi ignores unmanaged files)
WATCH_DIRS=(.claude/skills .claude/agents .claude/commands .claude/output-styles .claude/hooks)
# What `ai-sync capture` takes when called without arguments
CAPTURE_DEFAULT=(.claude/CLAUDE.md .claude/settings.json .claude/agents .claude/commands .claude/skills .claude/output-styles .claude/hooks)
SECRET_RE='(sk-ant[-][A-Za-z0-9_-]{20,}|gh[p]_[A-Za-z0-9]{30,}|github_pa[t]_[A-Za-z0-9_]{30,}|xox[bp]-|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|"(api[_-]?key|token|secret|password)"[[:space:]]*:[[:space:]]*"[^"]{12,})'

notify() {
  local title=$1 body=$2
  if command -v herdr >/dev/null 2>&1; then
    herdr notification show "$title" --body "$body" --sound request >/dev/null 2>&1 || true
  fi
  if command -v notify-send >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    notify-send "$title" "$body" >/dev/null 2>&1 || true
  fi
  if command -v osascript >/dev/null 2>&1; then
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
      "$title" "$body" >/dev/null 2>&1 || true
  fi
  # WSL has no Linux desktop notifier: raise a native Windows toast instead
  local ps=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
  if [ -x "$ps" ] && [ -f "$HOME/.local/share/ai-sync/toast.ps1" ]; then
    timeout 30 "$ps" -NoProfile -ExecutionPolicy Bypass -File "$(wslpath -w "$HOME/.local/share/ai-sync/toast.ps1")" \
      -Title "$title" -Body "$body" >/dev/null 2>&1 || true
  fi
}

write_state() { printf '%s\t%s\t%s\n' "$1" "$(date +%Y-%m-%dT%H:%M:%S%z)" "$2" >"$STATE"; }

# settings.json is rewritten by Claude Code: ignore format-only changes and auto-restore
# a flipped defaultMode instead of treating them as drift.
settings_drift() {
  python3 - "$HOME/.claude/settings.json" <<'PY'
import json, subprocess, sys
live = json.load(open(sys.argv[1]))
want = json.loads(subprocess.run(["chezmoi", "cat", sys.argv[1]], capture_output=True, text=True, check=True).stdout)
if live == want:
    print("same")
else:
    live.get("permissions", {}).pop("defaultMode", None)
    want.get("permissions", {}).pop("defaultMode", None)
    print("mode-only" if live == want else "drift")
PY
}

# Prints drifted target paths (relative to $HOME), one per line.
local_drift() {
  local line flag path
  chezmoi status 2>/dev/null | while IFS= read -r line; do
    flag=${line:0:1}; path=${line:3}
    case $flag in A|D|M) ;; *) continue ;; esac
    if [ "$path" = ".claude/settings.json" ]; then
      [ "$(settings_drift 2>/dev/null)" = "drift" ] || continue
    fi
    echo "$path"
  done
  for d in "${WATCH_DIRS[@]}"; do
    [ -d "$HOME/$d" ] || continue
    chezmoi unmanaged "$HOME/$d" 2>/dev/null | while IFS= read -r path; do
      [ -d "$HOME/$path" ] && [ -z "$(ls -A "$HOME/$path")" ] && continue
      echo "$path"
    done
  done
}

# Turns managed files that mention $HOME into templates, so they work under any username.
templatize() {
  local f src
  find "$1" -type f 2>/dev/null | while IFS= read -r f; do
    src=$(chezmoi source-path "$f" 2>/dev/null) || continue
    case $src in *.tmpl) continue ;; esac
    grep -qIF "$HOME" "$f" || continue
    if grep -qF '{{' "$f"; then
      echo "ai-sync: ${f#"$HOME/"} mentions $HOME but contains '{{'; kept as a plain file" >&2
      continue
    fi
    chezmoi chattr +template "$f" >/dev/null || continue
    src=$(chezmoi source-path "$f") || continue
    python3 - "$src" "$HOME" <<'PY'
import sys
path, home = sys.argv[1:]
text = open(path).read()
open(path, "w").write(text.replace(home, "{{ .chezmoi.homeDir }}"))
PY
    echo "templated ${f#"$HOME/"}"
  done
}

# settings.json becomes a template: defaultMode per machine, $HOME portable, ai-sync hook added.
capture_settings() {
  local dir
  dir=$(chezmoi source-path "$HOME/.claude" 2>/dev/null) || {
    chezmoi add --recursive=false "$HOME/.claude" && dir=$(chezmoi source-path "$HOME/.claude")
  } || { echo "ai-sync: could not manage ~/.claude" >&2; return 1; }
  rm -f "$dir/settings.json" "$dir/settings.json.tmpl" "$dir/private_settings.json" "$dir/private_settings.json.tmpl"
  python3 - "$HOME/.claude/settings.json" "$dir/private_settings.json.tmpl" "$HOME" <<'PY' || return 1
import json, sys
src, dest, home = sys.argv[1:]
raw = open(src).read()
if "{{" in raw:
    sys.exit("ai-sync: settings.json contains '{{'; capture it by hand")
s = json.loads(raw)
s.setdefault("permissions", {})["defaultMode"] = "@@DEFAULT_MODE@@"
hook = home + "/.local/bin/ai-sync hook"
starts = s.setdefault("hooks", {}).setdefault("SessionStart", [])
if not any(h.get("command") == hook for g in starts for h in g.get("hooks", [])):
    starts.append({"hooks": [{"type": "command", "command": hook, "timeout": 10}]})
out = json.dumps(s, indent=2, ensure_ascii=False) + "\n"
out = out.replace('"@@DEFAULT_MODE@@"', '"{{ .defaultMode }}"').replace(home, "{{ .chezmoi.homeDir }}")
open(dest, "w").write(out)
PY
  # Write the hook into the live file now, so the capture itself is not reported as drift
  chezmoi apply --force "$HOME/.claude/settings.json" && echo "captured .claude/settings.json (template)"
}

cmd_capture() {
  local targets=("$@") t
  [ ${#targets[@]} -eq 0 ] && targets=("${CAPTURE_DEFAULT[@]}")
  for t in "${targets[@]}"; do
    t=${t#"$HOME/"}; t=${t%/}
    if [ ! -e "$HOME/$t" ]; then
      echo "skip $t (not found)"
      continue
    fi
    if [ "$t" = .claude/settings.json ]; then
      capture_settings
      continue
    fi
    chezmoi add "$HOME/$t" && echo "captured $t" && templatize "$HOME/$t"
  done
  echo
  echo "Review what will be committed:  git -C $SRC status"
  echo "Then publish it:                ai-sync push -m 'feat: capture config from $MACHINE'"
}

cmd_pull() {
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE_DIR/lock"
    flock -n 9 || exit 0
  fi
  : >"$LOG"

  if [ -n "$(git -C "$SRC" status --porcelain)" ]; then
    write_state source-dirty "uncommitted changes in $SRC"
    notify "ai-sync: repo has uncommitted changes ($MACHINE)" "Commit or discard them in $SRC, or run ai-sync push"
    return
  fi

  local drift
  drift=$(local_drift)
  if [ -n "$drift" ]; then
    local n first
    n=$(printf '%s\n' "$drift" | wc -l | tr -d ' ')
    first=$(printf '%s\n' "$drift" | head -3 | paste -sd ' ' -)
    write_state drift "$n local change(s): $first"
    notify "ai-sync: $n local change(s) not pushed ($MACHINE)" "$first · run: ai-sync push"
    return
  fi

  if ! git -C "$SRC" pull --ff-only --quiet >>"$LOG" 2>&1; then
    write_state pull-failed "git pull failed, see $LOG"
    notify "ai-sync: git pull failed ($MACHINE)" "See $LOG"
    return
  fi

  if ! chezmoi apply --force >>"$LOG" 2>&1; then
    write_state apply-failed "chezmoi apply failed, see $LOG"
    notify "ai-sync: apply failed ($MACHINE)" "See $LOG"
    return
  fi

  if grep -q '^deps: WARN' "$LOG"; then
    write_state deps-warn "$(grep '^deps: WARN' "$LOG" | head -2 | paste -sd ' ' -)"
    notify "ai-sync: dependency warnings ($MACHINE)" "See $LOG"
    return
  fi
  write_state ok "$(git -C "$SRC" log -1 --format='%h %s')"
}

cmd_status() {
  if [ -f "$STATE" ]; then tr '\t' ' ' <"$STATE"; else echo "no pull recorded yet"; fi
  local drift
  drift=$(local_drift)
  if [ -n "$drift" ]; then
    echo "local changes not pushed:"
    printf '%s\n' "$drift" | sed 's/^/  /'
  else
    echo "no local changes"
  fi
}

cmd_push() {
  local msg="chore: sync local config changes from $MACHINE"
  [ "${1:-}" = "-m" ] && [ -n "${2:-}" ] && msg=$2

  local drift templates=() path
  drift=$(local_drift)
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if [ -e "$HOME/$path" ] && ! chezmoi source-path "$HOME/$path" >/dev/null 2>&1; then
      chezmoi add "$HOME/$path" && templatize "$HOME/$path"
    elif chezmoi source-path "$HOME/$path" 2>/dev/null | grep -q '\.tmpl$'; then
      templates+=("$path")
    fi
  done <<<"$drift"
  chezmoi re-add

  git -C "$SRC" add -A
  if git -C "$SRC" diff --cached --quiet; then
    echo "ai-sync: nothing to push"
  else
    local hits
    hits=$(git -C "$SRC" diff --cached -U0 | grep -nE "^\+.*$SECRET_RE" | cut -d: -f1)
    if [ -n "$hits" ]; then
      echo "ai-sync: possible secret in staged changes, aborting (diff lines: $(echo $hits))" >&2
      echo "ai-sync: inspect with: git -C $SRC diff --cached" >&2
      git -C "$SRC" reset -q
      exit 1
    fi
    git -C "$SRC" diff --cached --stat
    git -C "$SRC" commit -qm "$msg" && git -C "$SRC" push -q && echo "ai-sync: pushed $(git -C "$SRC" log -1 --format=%h)"
  fi

  if [ ${#templates[@]} -gt 0 ]; then
    echo "ai-sync: these come from templates and need a manual edit in $SRC:"
    printf '  %s\n' "${templates[@]}"
  fi
  write_state ok "pushed from $MACHINE"
}

cmd_hook() {
  [ -f "$STATE" ] || exit 0
  local state detail
  state=$(cut -f1 "$STATE"); detail=$(cut -f3 "$STATE")
  [ "$state" = ok ] && exit 0
  python3 -c 'import json,sys; print(json.dumps({"systemMessage": "AI config out of sync (" + sys.argv[1] + "): " + sys.argv[2] + ". Run ai-sync status."}))' "$state" "$detail"
}

case "${1:-}" in
  capture) shift; cmd_capture "$@" ;;
  pull) cmd_pull ;;
  status) cmd_status ;;
  push) shift; cmd_push "$@" ;;
  hook) cmd_hook ;;
  *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
